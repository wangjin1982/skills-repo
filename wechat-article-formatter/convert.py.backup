#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
微信公众号文章格式化工具
将 Markdown 转换为适配微信公众号的精美 HTML
"""

import markdown
from bs4 import BeautifulSoup
import sys
import argparse

def apply_inline_styles(html_content):
    """应用内联CSS样式"""
    soup = BeautifulSoup(html_content, 'html.parser')

    # H2 标题样式
    for h2 in soup.find_all('h2'):
        h2['style'] = (
            'font-size: 20px; '
            'font-weight: bold; '
            'color: #1a1f5c; '
            'margin-top: 35px; '
            'margin-bottom: 15px; '
            'padding-left: 12px; '
            'border-left: 4px solid #7c3aed; '
            'background: linear-gradient(90deg, #f3f4f6 0%, transparent 100%); '
            'padding: 10px 15px;'
        )

    # H3 标题样式
    for h3 in soup.find_all('h3'):
        h3['style'] = (
            'font-size: 18px; '
            'font-weight: bold; '
            'color: #374151; '
            'margin-top: 25px; '
            'margin-bottom: 12px; '
            'padding-left: 10px; '
            'border-left: 3px solid #a78bfa;'
        )

    # 段落样式
    for p in soup.find_all('p'):
        p['style'] = (
            'font-size: 16px; '
            'line-height: 1.8; '
            'color: #374151; '
            'margin: 15px 0; '
            'text-align: justify;'
        )

    # 列表样式
    for ul in soup.find_all('ul'):
        ul['style'] = (
            'margin: 15px 0; '
            'padding-left: 30px;'
        )

    for li in soup.find_all('li'):
        li['style'] = (
            'font-size: 16px; '
            'line-height: 1.8; '
            'color: #374151; '
            'margin: 8px 0;'
        )

    # 有序列表
    for ol in soup.find_all('ol'):
        ol['style'] = (
            'margin: 15px 0; '
            'padding-left: 30px;'
        )

    # 代码块样式
    for pre in soup.find_all('pre'):
        pre['style'] = (
            'background-color: #1f2937; '
            'color: #f9fafb; '
            'padding: 16px; '
            'border-radius: 8px; '
            'overflow-x: auto; '
            'margin: 20px 0; '
            'font-family: "Monaco", "Menlo", "Ubuntu Mono", monospace;'
        )
        for code in pre.find_all('code'):
            code['style'] = (
                'background-color: transparent; '
                'color: #f9fafb; '
                'padding: 0; '
                'font-family: inherit;'
            )

    # 行内代码样式
    for code in soup.find_all('code'):
        if code.parent.name != 'pre':
            code['style'] = (
                'background-color: #f3f4f6; '
                'color: #7c3aed; '
                'padding: 2px 6px; '
                'border-radius: 3px; '
                'font-family: "Monaco", "Menlo", "Ubuntu Mono", monospace; '
                'font-size: 14px;'
            )

    # 强调(加粗)样式
    for strong in soup.find_all('strong'):
        strong['style'] = (
            'color: #7c3aed; '
            'font-weight: bold;'
        )

    # 引用块样式
    for blockquote in soup.find_all('blockquote'):
        blockquote['style'] = (
            'border-left: 4px solid #a78bfa; '
            'padding-left: 20px; '
            'margin: 20px 0; '
            'color: #6b7280; '
            'font-style: italic; '
            'background-color: #f9fafb; '
            'padding: 15px 20px;'
        )

    # 表格样式
    for table in soup.find_all('table'):
        table['style'] = (
            'border-collapse: collapse; '
            'width: 100%; '
            'margin: 20px 0; '
            'font-size: 14px;'
        )

    for th in soup.find_all('th'):
        th['style'] = (
            'background-color: #7c3aed; '
            'color: white; '
            'padding: 12px; '
            'text-align: left; '
            'border: 1px solid #ddd;'
        )

    for td in soup.find_all('td'):
        td['style'] = (
            'padding: 10px; '
            'border: 1px solid #ddd;'
        )

    # 分隔线样式
    for hr in soup.find_all('hr'):
        hr['style'] = (
            'border: none; '
            'border-top: 2px solid #e5e7eb; '
            'margin: 30px 0;'
        )

    # 链接样式
    for a in soup.find_all('a'):
        a['style'] = (
            'color: #7c3aed; '
            'text-decoration: none; '
            'border-bottom: 1px solid #a78bfa;'
        )

    return str(soup)

def markdown_to_html(input_file, skip_h1=True):
    """将 Markdown 转换为 HTML"""

    # 读取 Markdown 文件
    with open(input_file, 'r', encoding='utf-8') as f:
        md_content = f.read()

    # 如果需要跳过 H1 标题
    if skip_h1:
        lines = md_content.split('\n')
        filtered_lines = []
        skip_next_empty = False

        for line in lines:
            if line.startswith('# ') and not line.startswith('## '):
                skip_next_empty = True
                continue
            if skip_next_empty and line.strip() == '':
                skip_next_empty = False
                continue
            skip_next_empty = False
            filtered_lines.append(line)

        md_content = '\n'.join(filtered_lines)

    # 转换为 HTML
    html = markdown.markdown(
        md_content,
        extensions=[
            'markdown.extensions.extra',
            'markdown.extensions.codehilite',
            'markdown.extensions.tables',
            'markdown.extensions.toc',
            'markdown.extensions.nl2br'
        ],
        extension_configs={
            'markdown.extensions.codehilite': {
                'css_class': 'highlight',
                'linenums': False
            }
        }
    )

    # 应用内联样式
    styled_html = apply_inline_styles(html)

    # 创建完整的 HTML 文档
    full_html = f"""<!-- ⚠️ 标题请在微信公众号编辑器中单独填写 -->
<section style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 16px; color: #374151; line-height: 1.8; padding: 20px;">
{styled_html}
</section>"""

    return full_html

def main():
    parser = argparse.ArgumentParser(description='微信公众号文章格式化工具')
    parser.add_argument('input', help='输入的 Markdown 文件路径')
    parser.add_argument('-o', '--output', help='输出的 HTML 文件路径')
    parser.add_argument('--keep-h1', action='store_true', help='保留 H1 标题')

    args = parser.parse_args()

    # 确定输出文件路径
    if args.output:
        output_file = args.output
    else:
        output_file = args.input.rsplit('.', 1)[0] + '_wechat.html'

    # 转换
    html = markdown_to_html(args.input, skip_h1=not args.keep_h1)

    # 保存
    with open(output_file, 'w', encoding='utf-8') as f:
        f.write(html)

    print(f"✅ 转换成功！")
    print(f"📄 输出文件：{output_file}")
    print(f"\n📋 发布步骤：")
    print(f"1. 在浏览器中打开：file://{output_file}")
    print(f"2. 按 Ctrl+A 全选，Ctrl+C 复制")
    print(f"3. 在微信公众号编辑器中粘贴")
    print(f"4. 在标题栏填写文章标题")
    print(f"5. 检查格式后发布")

if __name__ == '__main__':
    main()
